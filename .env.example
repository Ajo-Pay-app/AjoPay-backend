# Postgres connection string (local, Neon, Supabase, Railway...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ajopay"

# Service ports
GATEWAY_PORT=4000
SETTLEMENT_PORT=4001
FX_PORT=4002
INDEXER_PORT=4003

# Internal service URLs
SETTLEMENT_URL=http://localhost:4001
FX_URL=http://localhost:4002

# Shared secret between services (change it!)
INTERNAL_API_KEY=change-me-internal-key

# Merchant auth
JWT_SECRET=change-me-jwt-secret

# Allow the demo "simulate payment" endpoint (set false in production)
DEMO_MODE=true

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Stellar / Soroban
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
SETTLEMENT_CONTRACT_ID=PASTE_AFTER_DEPLOY
GOVERNANCE_CONTRACT_ID=PASTE_AFTER_DEPLOY
INDEXER_POLL_MS=8000

# FX spread charged on top of the market rate (basis points)
FX_SPREAD_BPS=50
